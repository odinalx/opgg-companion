{
  "name": "opgg-companion",
  "version": "0.1.0",
  "description": "Compagnon League of Legends : profil, historique, stats et draft helper (données OP.GG MCP + client LoL)",
  "main": "./out/main/index.js",
  "author": "odinalx",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "build:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "mock:lcu": "node scripts/mock-lcu.mjs",
    "smoke:opgg": "SMOKE=1 vitest run scripts/smoke-opgg.test.ts",
    "bench:build": "BENCH=1 vitest run scripts/build-benchmarks.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "koffi": "^2.16.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11",
    "zustand": "5.0.15"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
